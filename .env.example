# Rember Secrets — Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# --- Required ---
GOOGLE_API_KEY=your_google_api_key_here

# --- Optional (for future providers) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Optional overrides ---
# REMBER_DATA_DIR=~/.rember       # Override default data directory
# REMBER_CONFIG=./config.yaml     # Path to custom config file
